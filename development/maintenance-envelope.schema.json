{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assbox development maintenance candidate envelope v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "kind": {
      "const": "development-maintenance-candidate"
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidate_content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "production_lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dev_lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "chainman_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gate_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "oracle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "producer": {
      "type": "object",
      "properties": {
        "repository_id": {
          "type": "integer",
          "minimum": 1
        },
        "owner_id": {
          "type": "integer",
          "minimum": 1
        },
        "workflow_path": {
          "const": ".github/workflows/maintenance.yml"
        },
        "run_id": {
          "type": "integer",
          "minimum": 1
        },
        "run_attempt": {
          "type": "integer",
          "minimum": 1
        },
        "job_id": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "repository_id",
        "owner_id",
        "workflow_path",
        "run_id",
        "run_attempt",
        "job_id"
      ],
      "additionalProperties": false
    },
    "replacements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "enum": [
              "chainman.lock",
              "nix/dev/flake.lock"
            ]
          },
          "mode": {
            "const": "100644"
          },
          "old_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "new_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576
          },
          "content_base64": {
            "type": "string",
            "maxLength": 1398104,
            "pattern": "^[A-Za-z0-9+/]*={0,2}$"
          }
        },
        "required": [
          "path",
          "mode",
          "old_sha256",
          "new_sha256",
          "bytes",
          "content_base64"
        ],
        "additionalProperties": false
      }
    },
    "candidate_snapshot": {
      "$ref": "candidate-snapshot.schema.json"
    }
  },
  "required": [
    "schema",
    "kind",
    "base_commit",
    "candidate_content_sha256",
    "production_lock_sha256",
    "dev_lock_sha256",
    "chainman_revision",
    "policy_sha256",
    "gate_set_sha256",
    "oracle_sha256",
    "producer",
    "replacements",
    "candidate_snapshot"
  ],
  "additionalProperties": false
}
